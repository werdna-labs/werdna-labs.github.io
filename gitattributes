# Normalize line endings in the repo regardless of who commits from where.
# Working tree gets LF on Windows too, which keeps VS Code's status bar
# consistent and stops CRLF-vs-LF diff noise.
* text=auto eol=lf

# Never let Git touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.pdf  binary
